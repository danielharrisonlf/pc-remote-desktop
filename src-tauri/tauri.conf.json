{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PC Remote",
  "version": "0.2.0",
  "identifier": "com.pcremote.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "PC Remote", "width": 1000, "height": 740, "minWidth": 640, "minHeight": 520, "center": true }], "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'" } },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.png", "icons/icon.ico"], "windows": { "nsis": { "installMode": "currentUser" } } }
}
